# --- Patch: Expensive B-Rep Boolean Unions for Reference Planes and Coordinate Triads ---
# File: crates/rcad-occt/src/lib.rs

// Decoupled Lightweight Datum in rcad-geom and rcad-app
// Datums do not need OpenCASCADE solids!
#[derive(Debug, Clone, Serialize, Deserialize)]
pub struct DatumTriad {
    pub origin: [f32; 3],
    pub axes: [[f32; 3]; 3], // X, Y, Z directions
    pub length: f32,
}

impl DatumTriad {
    /// Generates lightweight colored line vertex buffers directly for WGPU / egui viewport
    pub fn to_vertex_lines(&self) -> Vec<([f32; 3], [u8; 4])> {
        let o = self.origin;
        vec![
            (o, [255, 60, 60, 255]), (add(o, scale(self.axes[0], self.length)), [255, 60, 60, 255]), // Red X
            (o, [60, 255, 60, 255]), (add(o, scale(self.axes[1], self.length)), [60, 255, 60, 255]), // Green Y
            (o, [60, 120, 255, 255]), (add(o, scale(self.axes[2], self.length)), [60, 120, 255, 255]), // Blue Z
        ]
    }
}


# --- Patch: Activating rcad-truck as a Zero-FFI Pure-Rust B-Rep Kernel ---
# File: crates/rcad-truck/src/lib.rs

// Working Pure-Rust Truck Kernel in crates/rcad-truck/src/lib.rs
use truck_modeling::builder;
use truck_modeling::{Point3, Vector3, Solid as TruckSolid};
use truck_meshing::tessellation::faces_tessellation;

pub struct TruckBackend {
    next_id: u64,
    solids: std::collections::HashMap<u64, TruckSolid>,
}

impl GeometryBackend for TruckBackend {
    fn box_solid(&mut self, size: glam::DVec3) -> GeomResult<ShapeId> {
        let p = Point3::new(0.0, 0.0, 0.0);
        let solid = builder::tsweep(
            &builder::tsweep(
                &builder::vertex(p),
                Vector3::new(size.x, 0.0, 0.0)
            ),
            Vector3::new(0.0, size.y, size.z)
        );
        let id = self.next_id;
        self.next_id += 1;
        self.solids.insert(id, solid);
        Ok(ShapeId(id))
    }

    fn tessellate(&mut self, shape: ShapeId) -> GeomResult<TriangleMesh> {
        let solid = self.solids.get(&shape.0).ok_or(GeomError::UnknownShape(shape))?;
        let polygon_mesh = faces_tessellation(solid, 0.01);
        Ok(convert_truck_mesh(&polygon_mesh))
    }
}

