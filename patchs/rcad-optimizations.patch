# --- Patch: Destruction & Re-allocation of GeometryBackend on Every Rebuild ---
# File: crates/rcad-app/src/app.rs & crates/rcad-param/src/lib.rs

// Optimized rcad-param/src/lib.rs with DAG Incremental ShapeCache
pub struct ShapeCache {
    /// Cached shape IDs per feature UUID + parameter hash
    entries: std::collections::HashMap<Uuid, (u64, ShapeId)>,
}

impl ShapeCache {
    pub fn rebuild_part_incremental(
        &mut self,
        part: &Part,
        backend: &mut dyn GeometryBackend,
    ) -> RebuildResult {
        let mut named: HashMap<Uuid, ShapeId> = HashMap::new();
        let mut history: Vec<(Uuid, ShapeId)> = Vec::new();
        let mut current: Option<ShapeId> = None;
        let mut first_dirty_idx = None;

        // 1. Identify first dirty feature via parameter hash
        for (idx, feature) in part.features.iter().enumerate() {
            let hash = compute_feature_hash(feature);
            if let Some(&(cached_hash, shape_id)) = self.entries.get(&feature.id) {
                if cached_hash == hash && first_dirty_idx.is_none() {
                    // Feature unchanged: reuse cached shape
                    named.insert(feature.id, shape_id);
                    history.push((feature.id, shape_id));
                    current = Some(shape_id);
                    continue;
                }
            }
            if first_dirty_idx.is_none() {
                first_dirty_idx = Some(idx);
            }
            // Invalidate subsequent features
            self.entries.remove(&feature.id);
            if let Ok(Some(new_shape)) = eval_feature(&feature.kind, current, &named, &history, backend) {
                self.entries.insert(feature.id, (hash, new_shape));
                named.insert(feature.id, new_shape);
                history.push((feature.id, new_shape));
                current = Some(new_shape);
            }
        }
        // Tessellate only the final dirty shape
        // ...
    }
}


# --- Patch: Synchronous B-Rep Kernel Math Freezing the egui Main UI Thread ---
# File: crates/rcad-app/src/app.rs

// Asynchronous Kernel Worker in crates/rcad-app/src/app.rs
use crossbeam_channel::{bounded, Sender, Receiver};
use std::sync::atomic::{AtomicU64, Ordering};
use std::sync::Arc;

pub struct KernelWorker {
    pub tx: Sender<RebuildJob>,
    pub rx: Receiver<RebuildResponse>,
    pub current_version: Arc<AtomicU64>,
}

pub struct RebuildJob {
    pub version: u64,
    pub part: rcad_doc::Part,
}

pub struct RebuildResponse {
    pub version: u64,
    pub mesh: rcad_geom::TriangleMesh,
    pub errors: Vec<String>,
}

impl KernelWorker {
    pub fn spawn() -> Self {
        let (job_tx, job_rx) = bounded::<RebuildJob>(2); // Backpressure bounded queue
        let (res_tx, res_rx) = bounded::<RebuildResponse>(2);
        let version_counter = Arc::new(AtomicU64::new(0));
        let version_worker = version_counter.clone();

        std::thread::Builder::new()
            .name("rcad-kernel-worker".into())
            .spawn(move || {
                let mut backend = rcad_occt::OcctBackend::default();
                let mut cache = rcad_param::ShapeCache::new();
                while let Ok(job) = job_rx.recv() {
                    // Check if a newer job was already queued; skip stale frames
                    if job.version < version_worker.load(Ordering::Relaxed) {
                        continue;
                    }
                    let res = cache.rebuild_part_incremental(&job.part, &mut backend);
                    let _ = res_tx.send(RebuildResponse {
                        version: job.version,
                        mesh: res.display_mesh,
                        errors: res.errors,
                    });
                }
            })
            .expect("Failed to spawn kernel worker thread");

        Self { tx: job_tx, rx: res_rx, current_version: version_counter }
    }
}

